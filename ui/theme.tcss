/* Tema "pantalla azul" — fiel a WordPerfect / S10 / dBase en DOS.
   Paleta de 16 colores clasica, bordes de linea (caracteres de dibujo
   de caja, los mismos que usaba la pagina de codigos 437 del DOS). */

Screen {
    background: #0000AA;
    color: #FFFFFF;
}

Header {
    background: #00AAAA;
    color: #000000;
    text-style: bold;
}

Footer {
    background: #00AAAA;
    color: #000000;
}

Footer > .footer--key {
    background: #00AAAA;
    color: #0000AA;
    text-style: bold;
}

Footer > .footer--description {
    background: #00AAAA;
    color: #000000;
}

#titulo {
    background: #0000AA;
    color: #FFFF55;
    text-style: bold;
    content-align: center middle;
    height: 1;
}

#subtitulo {
    background: #0000AA;
    color: #FFFFFF;
    content-align: center middle;
    height: 1;
}

.panel {
    background: #0000AA;
    border: heavy #FFFFFF;
    color: #FFFFFF;
}

.panel:focus-within {
    border: heavy #FFFF55;
}

DataTable {
    background: #0000AA;
    color: #FFFFFF;
}

DataTable > .datatable--header {
    background: #0000AA;
    color: #FFFF55;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #00AAAA;
    color: #000000;
}

DataTable > .datatable--fixed {
    background: #0000AA;
}

ListView {
    background: #0000AA;
    color: #FFFFFF;
}

ListItem {
    background: #0000AA;
    color: #FFFFFF;
}

ListItem:hover {
    background: #5555FF;
}

ListView > ListItem.--highlight {
    background: #00AAAA;
    color: #000000;
}

Input {
    background: #000000;
    color: #FFFF55;
    border: tall #FFFFFF;
}

Input:focus {
    border: tall #FFFF55;
}

Checkbox {
    background: #0000AA;
    color: #FFFFFF;
}

Label {
    color: #FFFFFF;
}

.etiqueta {
    color: #55FFFF;
    text-style: bold;
}

.error {
    color: #FF5555;
    text-style: bold;
}

.ok {
    color: #55FF55;
}

.dato {
    color: #FFFF55;
}

.ayuda {
    color: #AAAAAA;
    text-style: italic;
}

Button {
    background: #00AAAA;
    color: #000000;
    border: none;
    text-style: bold;
}

Button:focus {
    background: #FFFF55;
}

Button:hover {
    background: #55FFFF;
}

.fila-formulario {
    height: auto;
    width: 100%;
}

.col-campos {
    width: 2fr;
    height: auto;
}

.col-selector {
    width: 1fr;
    min-width: 30;
    height: 100%;
}

SelectorReferencias {
    background: #0000AA;
    border: heavy #FFFFFF;
    height: 100%;
}

SelectorReferencias:focus-within {
    border: heavy #FFFF55;
}

.advertencia {
    color: #000000;
    background: #FFFF55;
    text-style: bold;
}

.resumen-total {
    color: #FFFF55;
    text-style: bold;
}

.resumen-etiqueta {
    color: #55FFFF;
}

.grupo-titulo {
    color: #000000;
    background: #55FFFF;
    text-style: bold;
}

.migaja {
    color: #55FFFF;
    text-style: italic;
    height: 1;
}

DataTable > .datatable--odd-row {
    background: #0000AA;
}
